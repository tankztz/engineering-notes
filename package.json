{
  "name": "engineering-notes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "build": "wrangler deploy --dry-run --outdir dist && tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "seed": "node --experimental-strip-types scripts/manage.ts seed",
    "sync": "node --experimental-strip-types scripts/manage.ts sync",
    "source": "node --experimental-strip-types scripts/manage.ts source",
    "export": "node --experimental-strip-types scripts/manage.ts export",
    "docs:build": "vitepress build docs && node scripts/build-template.mjs",
    "pretest": "npm run docs:build"
  },
  "dependencies": {
    "hono": "^4.12.23",
    "markdown-it": "^15.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.2",
    "vitepress": "^1.6.4",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22"
  }
}
