{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engineering-notes",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "engineering-notes.tianzezhao.com", "custom_domain": true }],
  "vars": { "SITE_URL": "https://engineering-notes.tianzezhao.com" },
  "assets": { "directory": "./docs/.vitepress/dist", "binding": "ASSETS", "run_worker_first": true },
  "build": { "command": "npm run docs:build", "watch_dir": ["docs/.vitepress/theme", "docs/.vitepress/config.mts", "docs/index.md", "docs/public", "scripts/build-template.mjs"] },
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "engineering-notes", "database_id": "44c0bc1f-c9a3-4eea-9768-d288ed3957c2", "migrations_dir": "migrations" }],
  "vectorize": [{ "binding": "LESSONS", "index_name": "engineering-notes" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
